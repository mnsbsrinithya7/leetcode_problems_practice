class Solution {
    public int[] nextGreaterElement(int[] nums1, int[] nums2) {
       int[] ans=new int[nums1.length]; 
        int k=0; 
        for(int i=0;i<nums1.length;i++){ 
            for(int j=0;j<nums2.length;j++){ 
                if(nums1[i]==nums2[j] && j<=nums2.length-1){ 
                    ans[k]=-1;
                    for(int s=j+1;s<nums2.length;s++){ 
                        if(nums2[s]>nums2[j]){ 
                            ans[k]=nums2[s]; 
                            
                            break; 
                        }
                    } 
                    k++;
                    
                } 
                
            } 
        } 
        return ans; 
    }
}
